{
  "name": "gadget-galli",
  "private": true,
  "version": "1.0.0",
  "description": "Gadget Galli: Hyderabad electronics shops, delivered in hours",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "db:seed:generate": "node supabase/seed/generate-seed.mjs",
    "db:test": "bash supabase/tests/run-tests.sh",
    "mobile": "pnpm --filter @gg/mobile start",
    "admin": "pnpm --filter @gg/admin dev",
    "admin:build": "pnpm --filter @gg/admin build",
    "dev-stack": "node scripts/dev-stack/server.mjs",
    "e2e:prepare": "node scripts/e2e/prepare.mjs",
    "e2e": "node scripts/e2e/smoke.mjs && node scripts/e2e/screens.mjs",
    "screenshots": "node scripts/e2e/screenshots.mjs",
    "deploy:hostinger": "node scripts/deploy/hostinger.mjs",
    "deploy:check": "node scripts/deploy/check-sites.mjs",
    "dev-stack:reset": "node scripts/dev-stack/reset.mjs",
    "i18n:check": "node scripts/check-i18n.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "pg": "^8.23.1",
    "playwright": "1.56.1",
    "ws": "^8.22.0"
  }
}
