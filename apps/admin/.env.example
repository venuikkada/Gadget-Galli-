# Supabase project (Settings → API). The anon key is safe in the browser; data access is protected by RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Used by the public share pages (/s/product/:id, /s/shop/:id)
VITE_APP_SCHEME=gadgetgalli
VITE_PLAY_STORE_URL=https://play.google.com/store/apps/details?id=in.gadgetgalli.app
VITE_APP_STORE_URL=https://apps.apple.com/in/app/gadget-galli/id0000000000

# The customer web app, if you host one. Share pages then offer "Open in your browser".
VITE_CUSTOMER_APP_URL=
