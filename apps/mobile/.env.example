# Supabase project (Dashboard -> Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google Maps / Places (Android Maps SDK + Places API (New)). Optional: without it the app uses the area list.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_ANDROID_API_KEY=
GOOGLE_MAPS_IOS_API_KEY=

# Public web address of the admin panel; shared links look like <this>/s/product/<id>
EXPO_PUBLIC_SHARE_BASE_URL=https://gadgetgalli.in

# 1 shows the demo phone numbers on the login screen. Only for demo servers with test OTPs; never in a store build.
EXPO_PUBLIC_DEMO=0

# Which side the app shows: all (the store app: customers and shop owners), customer or partner.
# The customer and Shop Partner websites set this in their config.js instead (docs/DEPLOY-HOSTINGER.md).
EXPO_PUBLIC_APP=all

# Expo / EAS (needed for push notifications in real builds)
EAS_PROJECT_ID=
EXPO_OWNER=

# Support contacts shown in Help
EXPO_PUBLIC_SUPPORT_PHONE=+919000000000
EXPO_PUBLIC_SUPPORT_WHATSAPP=+919000000000
